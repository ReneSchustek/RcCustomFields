{
    "name": "ruhrcoder/rc-custom-fields",
    "description": "Kundeneingaben pro Produkt – unterschiedliche Eingaben erzeugen separate Warenkorbpositionen",
    "version": "1.5.3",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Ruhrcoder",
            "homepage": "https://ruhrcoder.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcCustomFields\\RcCustomFields",
        "label": {
            "de-DE": "Kundeneingaben",
            "en-GB": "Custom Fields"
        },
        "description": {
            "de-DE": "Kundeneingaben pro Produkt. Unterschiedliche Eingaben erzeugen separate Warenkorbpositionen statt Mengenerhöhung.",
            "en-GB": "Customer inputs per product. Different inputs create separate cart line items instead of increasing quantity."
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcCustomFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcCustomFields\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test:js": "node --test tests/Js/rc-custom-fields.suffix-event.test.mjs",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test",
            "@test:js"
        ]
    }
}
